# ==============================================================================
# Enterprise Monitoring Stack — Environment Configuration Example
# Copy this file to '.env' and fill in your actual credentials.
# ==============================================================================

# Ingress & Public Domain
MONITORING_DOMAIN=monitoring.example.com
MONITORING_HOST_IP=10.0.0.10

# Grafana Admin Credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=ChangeMeStrongPassword123!
GF_SERVER_ROOT_URL=https://monitoring.example.com/

# Prometheus Storage & Retention
PROMETHEUS_RETENTION_SIZE=25GB
PROMETHEUS_RETENTION_TIME=30d

# Rocket.Chat Alertmanager Webhook
ROCKETCHAT_WEBHOOK_URL=https://chat.example.com/hooks/YOUR_WEBHOOK_TOKEN_HERE

# VMware vCenter Telephony / Infrastructure
VCENTER_HOST=10.0.0.50
VCENTER_USER=administrator@vsphere.local
VCENTER_PASSWORD=YourVcenterPasswordHere

# Asterisk VoIP AMI Credentials
ASTERISK_HOST_IP=10.0.0.200
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=ami_user
ASTERISK_AMI_PASS=AmiSecretPasswordHere
ASTERISK_EXPORTER_PORT=9200
